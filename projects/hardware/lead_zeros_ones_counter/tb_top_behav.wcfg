<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_top_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="std" />
            <top_module name="tb_pkg" />
            <top_module name="tb_top" />
            <top_module name="uvm_pkg" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000000 us"></ZoomStartTime>
      <ZoomEndTime time="20.030001 us"></ZoomEndTime>
      <Cursor1Time time="0.621531 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="230"></NameColumnWidth>
      <ValueColumnWidth column_width="100"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="4" />
   <wvobject type="logic" fp_name="/tb_top/vif/i_clock">
      <obj_property name="ElementShortName">i_clock</obj_property>
      <obj_property name="ObjectShortName">i_clock</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_top/vif/o_ones_count">
      <obj_property name="ElementShortName">o_ones_count[2:0]</obj_property>
      <obj_property name="ObjectShortName">o_ones_count[2:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_top/vif/o_lead_zeros_count">
      <obj_property name="ElementShortName">o_lead_zeros_count[2:0]</obj_property>
      <obj_property name="ObjectShortName">o_lead_zeros_count[2:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_top/vif/i_data">
      <obj_property name="ElementShortName">i_data[3:0]</obj_property>
      <obj_property name="ObjectShortName">i_data[3:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
</wave_config>
