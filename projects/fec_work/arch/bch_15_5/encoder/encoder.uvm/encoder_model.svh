class encoder_model#(NB_WORD, NB_CODEWORD) extends uvm_object;
    `uvm_object_param_utils(encoder_model#(NB_WORD, NB_CODEWORD))

    function new(string name="encoder_model");
        super.new(name);
    endfunction
    
    // | w  | w     | p          | cw              |
    // | 00 | 00000 | 0000000000 | 000000000000000 |
    // | 01 | 00001 | 1101100101 | 000011101100101 |
    // | 02 | 00010 | 0110101100 | 000100110101100 |
    // | 03 | 00011 | 1011101001 | 000111011101001 |
    // | 04 | 00100 | 1101011000 | 001001101011000 |
    // | 05 | 00101 | 0000111101 | 001010000111101 |
    // | 06 | 00110 | 1011110100 | 001101011110100 |
    // | 07 | 00111 | 0110010001 | 001110110010001 |
    // | 08 | 01000 | 0111011001 | 010000111011001 |
    // | 09 | 01001 | 1010111100 | 010011010111100 |
    // | 10 | 01010 | 0001110101 | 010100001110101 |
    // | 11 | 01011 | 1100010000 | 010111100010000 |
    // | 12 | 01100 | 1010000101 | 011001010000101 |
    // | 13 | 01101 | 0111101000 | 011010111101000 |
    // | 14 | 01110 | 1100101101 | 011101100101101 |
    // | 15 | 01111 | 0010011111 | 011110010011111 |
    // | 16 | 10000 | 1110110010 | 100001110110010 |
    // | 17 | 10001 | 0011010111 | 100010011010111 |
    // | 18 | 10010 | 1001101011 | 100101001101011 |
    // | 19 | 10011 | 0100001110 | 100110100001110 |
    // | 20 | 10100 | 0011101010 | 101000011101010 |
    // | 21 | 10101 | 1110001111 | 101011110001111 |
    // | 22 | 10110 | 1001011010 | 101101001011010 |
    // | 23 | 10111 | 0101111011 | 101110101111011 |
    // | 24 | 11000 | 1000011110 | 110001000011110 |
    // | 25 | 11001 | 0101000110 | 110010101000110 |
    // | 26 | 11010 | 1111000111 | 110101111000111 |
    // | 27 | 11011 | 0010100010 | 110110010100010 |
    // | 28 | 11100 | 0100110111 | 111000100110111 |
    // | 29 | 11101 | 1000100011 | 111011000100011 |
    // | 30 | 11110 | 0001101100 | 111100001101100 |
    // | 31 | 11111 | 1111111111 | 111111111111111 |
    bit [NB_CODEWORD-1:0] bch_15_5_code [32] = '{
        'b000000000000000   ,
        'b000011101100101   ,
        'b000100110101100   ,
        'b000111011101001   ,
        'b001001101011000   ,
        'b001010000111101   ,
        'b001101011110100   ,
        'b001110110010001   ,
        'b010000111011001   ,
        'b010011010111100   ,
        'b010100001110101   ,
        'b010111100010000   ,
        'b011001010000101   ,
        'b011010111101000   ,
        'b011101100101101   ,
        'b011110010011111   ,
        'b100001110110010   ,
        'b100010011010111   ,
        'b100101001101011   ,
        'b100110100001110   ,
        'b101000011101010   ,
        'b101011110001111   ,
        'b101101001011010   ,
        'b101110101111011   ,
        'b110001000011110   ,
        'b110010101000110   ,
        'b110101111000111   ,
        'b110110010100010   ,
        'b111000100110111   ,
        'b111011000100011   ,
        'b111100001101100   ,
        'b111111111111111   
    };

    function void get_output(bit [NB_WORD-1:0] word, ref bit [NB_CODEWORD-1:0] codeword);
        codeword = '0;
        encode(word, codeword);
    endfunction

    function void encode(bit [NB_WORD-1:0] word, ref bit [NB_CODEWORD-1:0] codeword);
        codeword = bch_15_5_code[word];
        `uvm_info(get_name(), $sformatf("word %05b codeword %015b", word, codeword), UVM_DEBUG)
    endfunction

endclass