      <obj_property name="ElementShortName">o_led_b[3:0]</obj_property>
      <obj_property name="ObjectShortName">o_led_b[3:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_top/vif/i_switch">
